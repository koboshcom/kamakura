OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ENABLE_IMESSAGE=false
ENABLE_WHATSAPP=false
# Empty allowlists deny all chats. Separate exact chat IDs with commas.
# Use * only on a dedicated bot account after everyone has agreed.
IMESSAGE_ALLOWED_CHATS=
WHATSAPP_ALLOWED_CHATS=
IMESSAGE_DB_PATH=~/Library/Messages/chat.db
IMESSAGE_POLL_MS=1000
WHATSAPP_AUTH_DIR=./data/whatsapp-auth
ENABLE_WHATSAPP_REACTIONS=true
DATA_DIR=./data
PERSONA_PATH=./persona.md
HISTORY_LIMIT=40
DEBOUNCE_MS=4000
MESSAGE_DELAY_MS=800
MAX_REPLY_MESSAGES=3
MAX_REPLY_CHARS=1200
MAX_INPUT_CHARS=8000
MAX_OUTPUT_TOKENS=512
MAX_CONCURRENT_REQUESTS=2
REQUEST_TIMEOUT_MS=120000
ENABLE_WEB_SEARCH=true
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
MAX_MEDIA_BYTES=20971520
MEDIA_TIMEOUT_MS=90000
VIDEO_MAX_SECONDS=20
AUDIO_MAX_SECONDS=300
# iMessage host and core must share a random token. Generate with openssl rand -hex 32.
IMESSAGE_USE_BRIDGE=true
BRIDGE_TOKEN=
BRIDGE_URL=http://127.0.0.1:47621
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=47621
LOG_LEVEL=info
