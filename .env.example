# Operator settings. Copy to .env; never commit credentials.
# Paths are container paths unless explicitly labeled host paths.

# === Identity and operator prompts ===
# Persona file INSIDE container; default mounted file. Never set to a host-only path.
PERSONA_PATH=./persona.md
# Display name; blank uses shipped identity.json default.
BOT_NAME=
# Additional operator personality text; does not alter permissions.
BOT_PERSONALITY=
# Inline system presentation; takes precedence over prompt/persona files.
SYSTEM_PROMPT=
# Prompt file path INSIDE container, e.g. /app/config/prompt.md.
SYSTEM_PROMPT_PATH=
# Inline persona fallback when no system prompt override is supplied.
PERSONA_TEXT=
# Blank auto-selects default style or persona-only for custom presentation; default, persona, custom.
CHAT_STYLE_MODE=
# Inline custom style, replacing fixed conversational guidance only.
CHAT_STYLE_TEXT=
# Style file INSIDE container; inline style wins.
CHAT_STYLE_PATH=
# Host file mounted read-only at /app/persona.md.
PERSONA_FILE=./persona.md
# Host configuration directory mounted read-only at /app/config.
CONFIG_DIR=./config

# === Language-model provider and budgets ===
# Language-model provider credential; never commit .env.
OPENAI_API_KEY=
# Main chat model.
OPENAI_MODEL=gpt-6-luna
# Responses reasoning effort: none, low, medium, high, xhigh, max
OPENAI_REASONING_EFFORT=low
# Chat max steps.
CHAT_MAX_STEPS=12
# Chat context tokens.
CHAT_CONTEXT_TOKENS=256000
# Worker context tokens.
WORKER_CONTEXT_TOKENS=256000
# Worker reasoning budget; independent of chat effort.
OPENAI_WORKER_EFFORT=high
# Worker timeout ms.
WORKER_TIMEOUT_MS=600000
# Worker max output tokens.
WORKER_MAX_OUTPUT_TOKENS=4096
# Worker max steps.
WORKER_MAX_STEPS=24
# Worker max concurrent.
WORKER_MAX_CONCURRENT=2
# Responses provider URL prefix for all language-model calls.
OPENAI_BASE_URL=https://api.openai.com/v1
# Worker model; blank inherits OPENAI_MODEL.
OPENAI_WORKER_MODEL=
# Chat and worker compaction model; blank inherits OPENAI_MODEL.
OPENAI_SUMMARY_MODEL=
# Learning observer model; blank inherits OPENAI_MODEL.
OPENAI_LEARNING_MODEL=
# Optional draft review model; blank inherits OPENAI_MODEL.
OPENAI_REVIEW_MODEL=

# === Telegram ===
# Telegram bot credential from BotFather.
TELEGRAM_BOT_TOKEN=
# Exact chat IDs, comma separated. Empty denies all. * allows all (not recommended).
TELEGRAM_ALLOWED_CHATS=
# ambient lets the model choose explicit delivery or silence. mentions accepts mentions/replies only.
TELEGRAM_GROUP_MODE=ambient
# Enable reactions.
ENABLE_REACTIONS=true

# === Optional Discord owner DMs ===
# Bot DMs only; never guild/group messages. Off unless explicitly configured.
DISCORD_ENABLED=false
# Private bot token, never a user account token.
DISCORD_BOT_TOKEN=
# Exact decimal Discord user IDs, comma-separated. Never numbers in JSON.
DISCORD_ALLOWED_USERS=
# JSON Discord user ID to canonical owner ID. Every user must be mapped;
# each owner must already be explicitly listed in SANDBOX_ALLOWED_USERS.
DISCORD_OWNER_IDS={}

# === WhatsApp ===
# Opt-in text/image transport; requires private pairing and explicit owner mappings.
WHATSAPP_ENABLED=false
# Private absolute auth mount; Compose fixes this path. Provision separately before enabling.
WHATSAPP_AUTH_DIR=/run/kamakura-whatsapp
# Exact E.164 phone numbers, comma-separated; no wildcard.
WHATSAPP_ALLOWED_NUMBERS=
# JSON phone-to-canonical-owner-ID mapping; current authorized owner restriction remains.
WHATSAPP_OWNER_NUMBERS={}
# Optional JSON operator-bound LID-to-authorized-phone mapping.
WHATSAPP_LID_BINDINGS={}

# === Storage and embeddings ===
# Data dir.
DATA_DIR=./data
# Sole runtime storage. Compose mongo has no auth or public ports, core-only internal network.
MONGODB_URI=mongodb://mongo:27017
# Mongodb database.
MONGODB_DATABASE=kamakura
# Stable 8.0 default requires supported kernel. Linux 6.19..7.0.13 needs a kernel upgrade. An explicit mongo:7.0 image can support older test hosts; never downgrade an existing 8.0 database.
MONGODB_IMAGE=mongodb/mongodb-community-server:8.0-ubi8
# History limit.
HISTORY_LIMIT=40
# Same-owner chronological neighbors on each side of search hits, merged by stored record identity.
HISTORY_CONTEXT_MESSAGES=3
# Bounded fsynced history recovery journal, not an alternate database.
STORAGE_BUFFER_MAX_BYTES=16777216
# Independent embedding URL prefix. All three service settings are required; no keyword fallback or backfill.
EMBEDDING_BASE_URL=
# Embedding api key.
EMBEDDING_API_KEY=
# Embedding model.
EMBEDDING_MODEL=
# Embedding dimensions.
EMBEDDING_DIMENSIONS=768
# Embedding timeout ms.
EMBEDDING_TIMEOUT_MS=5000
# Embedding min score.
EMBEDDING_MIN_SCORE=0.3

# === Learning and optional reply review ===
# Exact authenticated owners permitted to teach lessons. Empty disables writes, * never works.
LEARNING_OWNER_IDS=
# Enable learning.
ENABLE_LEARNING=true
# Learning max bytes.
LEARNING_MAX_BYTES=16384
# Learning max lessons.
LEARNING_MAX_LESSONS=32
# Learning revisions.
LEARNING_REVISIONS=10
# Learning debounce ms.
LEARNING_DEBOUNCE_MS=15000
# Learning interval ms.
LEARNING_INTERVAL_MS=60000
# Learning timeout ms.
LEARNING_TIMEOUT_MS=30000
# Experimental casual draft editor, disabled until blind evaluation supports enabling it. Adds one model call per eligible bubble. Tool results, progress, voice and fenced code bypass it. Network/timeout failures preserve the original draft; factuality is not guaranteed.
ENABLE_REPLY_REVIEW=false
# Reply review timeout ms.
REPLY_REVIEW_TIMEOUT_MS=12000

# === Time, delivery and request limits ===
# IANA timezone fallback, then optional per-owner numeric Telegram-ID overrides.
DEFAULT_TIMEZONE=UTC
# Owner timezones.
OWNER_TIMEZONES={}
# Debounce ms.
# Quiet-window batching; lower only after testing your message bursts/cancellations.
DEBOUNCE_MS=4000
# Content-free stage timings and provider cache counts (off by default).
LATENCY_METRICS=false
# Optional casual first-step model; blank disables. Main model handles everything else.
FAST_MODEL=
# Elide older completed passive read bodies before model-backed compaction.
ELIDE_TOOL_OUTPUTS=true
# Message delay ms.
MESSAGE_DELAY_MS=800
# Max reply messages.
MAX_REPLY_MESSAGES=3
# Max reply chars.
MAX_REPLY_CHARS=1200
# Max input chars.
MAX_INPUT_CHARS=8000
# Max output tokens.
MAX_OUTPUT_TOKENS=2048
# Max concurrent requests.
MAX_CONCURRENT_REQUESTS=2
# Request timeout ms.
REQUEST_TIMEOUT_MS=120000
# Enable web search.
ENABLE_WEB_SEARCH=true
# Log level.
LOG_LEVEL=info
# Legacy timezone fallback when DEFAULT_TIMEZONE is absent; blank uses UTC.
TZ=

# === Independent speech and media ===
# Optional TTS has its own credentials. Blank settings omit voice replies.
SPEECH_TTS_BASE_URL=
# Speech tts api key.
SPEECH_TTS_API_KEY=
# Speech tts model.
SPEECH_TTS_MODEL=
# Speech tts voice.
SPEECH_TTS_VOICE=
# Incoming voice/video transcription model; independent endpoint below.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Independent speech host/key. Custom host requires its own key; no chat-key forwarding.
OPENAI_TRANSCRIBE_BASE_URL=
# Openai transcribe api key.
OPENAI_TRANSCRIBE_API_KEY=
# Vision requires configured provider/model image support. False skips image inspection.
VISION_ENABLED=true
# Max media bytes.
MAX_MEDIA_BYTES=20971520
# Media timeout ms.
MEDIA_TIMEOUT_MS=90000
# Video max seconds.
VIDEO_MAX_SECONDS=20
# Audio max seconds.
AUDIO_MAX_SECONDS=300

# === Desktop gateway ===
# Public HTTPS gateway origin; blank disables desktop links.
NOVNC_PUBLIC_URL=
# Novnc bind address.
NOVNC_BIND_ADDRESS=127.0.0.1
# Novnc port.
NOVNC_PORT=47831
# Container listener. Compose publishes the gateway on host loopback by default.
NOVNC_HOST=0.0.0.0
# Exact immediate proxy peer IPs as seen by the gateway, not client IPs/CIDRs. Host nginx via Compose may appear as the Compose bridge gateway, e.g. 172.18.0.1.
NOVNC_TRUSTED_PROXIES=
# DESKTOP_PUBLIC_BASE_URL, DESKTOP_PORT, DESKTOP_HOST and DESKTOP_BIND_ADDRESS remain fallback aliases. NOVNC_* takes precedence when set. One-time path bootstrap and independent cookie session lifetime, 1 hour default, 24 hours max.
DESKTOP_TOKEN_TTL_MS=3600000
# Legacy public origin alias; NOVNC_PUBLIC_URL takes precedence.
DESKTOP_PUBLIC_BASE_URL=
# Legacy port alias used only when NOVNC_PORT is unset.
DESKTOP_PORT=47831
# Legacy listener alias used only when NOVNC_HOST is unset.
DESKTOP_HOST=0.0.0.0
# Legacy publish alias used only when NOVNC_BIND_ADDRESS is unset.
DESKTOP_BIND_ADDRESS=127.0.0.1

# === Sandbox storage, resources and isolation ===
# Exact numeric Telegram sender IDs. No wildcard. Commands available in DMs only.
SANDBOX_ALLOWED_USERS=
# Sandbox image.
SANDBOX_IMAGE=kamakura-sandbox:local
# Writable root and full passwordless sudo, with an external firewall per owner.
SANDBOX_EGRESS_IMAGE=kamakura-egress:local
# Also deny host/LAN public IPs, if any (comma-separated numeric addresses).
SANDBOX_DENIED_IPS=
# Optional classic overlay2/XFS root quota only. Leave blank on Desktop.
SANDBOX_ROOTFS_SIZE=
# Same Docker daemon by default, never exposed to user containers.
SANDBOX_DOCKER_SOCKET=/var/run/docker.sock
# Core docker socket path.
CORE_DOCKER_SOCKET_PATH=/var/run/docker.sock
# Sandbox instance.
SANDBOX_INSTANCE=default
# Sandbox disk.
SANDBOX_DISK=35G
# Sandbox cpus.
SANDBOX_CPUS=2
# Sandbox memory.
SANDBOX_MEMORY=3g
# Chromium + XFCE need headroom for threads and Docker exec.
SANDBOX_PIDS=256
# Sandbox idle seconds.
SANDBOX_IDLE_SECONDS=1800
# Sandbox command timeout seconds.
SANDBOX_COMMAND_TIMEOUT_SECONDS=30
# Sandbox max output bytes.
SANDBOX_MAX_OUTPUT_BYTES=16000
# Host bind root. Compose resolves relative paths against the project directory.
SANDBOX_ROOT=./sandboxes
# Explicitly accepts a SOFT pre-command disk check, not a hard disk quota.
SANDBOX_ALLOW_SOFT_QUOTA=false
# Linux socket group, from stat -c '%g' /var/run/docker.sock. Usually 0 on Desktop.
DOCKER_GID=0
# Optional sandbox network name; blank uses instance-specific name.
SANDBOX_NETWORK_NAME=
# Container sandbox socket; Compose fixes this protected path.
DOCKER_SOCKET_PATH=/var/run/kamakura-sandbox.sock
# Container workspace view; Compose fixes read-only bind path.
SANDBOX_ROOT_VIEW=/app/sandboxes

# === Owner-local connector ===
# Explicit opt-in owner-local connector, worker tools only. Separate TLS/WSS proxy.
LOCAL_DEVICES_ENABLED=false
# Local devices host.
LOCAL_DEVICES_HOST=0.0.0.0
# Local devices port.
LOCAL_DEVICES_PORT=47943
# Local devices bind address.
LOCAL_DEVICES_BIND_ADDRESS=127.0.0.1
# Local devices public url.
LOCAL_DEVICES_PUBLIC_URL=
