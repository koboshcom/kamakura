# Required providers and channel access. Copy to .env and supply your own keys.
# History needs its independent embedding triplet on BOTH backends. No provider fallback.
STORAGE=mongo
# SQLite Compose requires compose.sqlite.yaml; see docs/CONFIGURATION.md.


# === Language-model provider and budgets ===
# Each part needs its own explicit URL, key and model. No shared key or fallback.
# PROVIDER_API_KEY is retired; remove it and populate each used part.
OPENAI_API_KEY=
# Main chat model.
OPENAI_MODEL=gpt-6-luna
# Responses URL prefix for main chat only.
OPENAI_BASE_URL=https://api.openai.com/v1

# === Telegram ===
# Telegram bot credential from BotFather.
TELEGRAM_BOT_TOKEN=
# Exact chat IDs, comma separated. Empty denies all. * allows all (not recommended).
TELEGRAM_ALLOWED_CHATS=

# === Optional Discord owner DMs ===
# Bot DMs only; never guild/group messages. Off unless explicitly configured.
DISCORD_ENABLED=false
# Private bot token, never a user account token.
DISCORD_BOT_TOKEN=
# Exact decimal Discord user IDs, comma-separated. Never numbers in JSON.
DISCORD_ALLOWED_USERS=
# JSON Discord user ID to canonical owner ID. Every user must be mapped;
# each owner must already be explicitly listed in SANDBOX_ALLOWED_USERS.
DISCORD_OWNER_IDS={}

# === WhatsApp ===
# Opt-in text/image transport; requires private pairing and explicit owner mappings.
WHATSAPP_ENABLED=false
# Exact E.164 phone numbers, comma-separated; no wildcard.
WHATSAPP_ALLOWED_NUMBERS=
# JSON phone-to-canonical-owner-ID mapping; current authorized owner restriction remains.
WHATSAPP_OWNER_NUMBERS={}
# Independent embedding URL prefix. All three service settings are required; no keyword fallback or backfill.
EMBEDDING_BASE_URL=
# Embedding api key.
EMBEDDING_API_KEY=
# Embedding model.
EMBEDDING_MODEL=

# === Time, delivery and request limits ===
# IANA timezone fallback, then optional per-owner numeric Telegram-ID overrides.
DEFAULT_TIMEZONE=UTC

# === Sandbox storage, resources and isolation ===
# Exact numeric Telegram sender IDs. No wildcard. Commands available in DMs only.
SANDBOX_ALLOWED_USERS=
