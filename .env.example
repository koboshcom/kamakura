OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Responses reasoning effort: none, low, medium, high, xhigh, max
OPENAI_REASONING_EFFORT=xhigh
TELEGRAM_BOT_TOKEN=
# Exact chat IDs, comma separated. Empty denies all. * allows all (not recommended).
TELEGRAM_ALLOWED_CHATS=
# ambient lets the model decide with <skip>. mentions responds only to mentions/replies.
TELEGRAM_GROUP_MODE=ambient
ENABLE_REACTIONS=true
DATA_DIR=./data
PERSONA_PATH=./persona.md
HISTORY_LIMIT=40
DEBOUNCE_MS=4000
MESSAGE_DELAY_MS=800
MAX_REPLY_MESSAGES=3
MAX_REPLY_CHARS=1200
MAX_INPUT_CHARS=8000
MAX_OUTPUT_TOKENS=512
MAX_CONCURRENT_REQUESTS=2
REQUEST_TIMEOUT_MS=120000
ENABLE_WEB_SEARCH=true
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
MAX_MEDIA_BYTES=20971520
MEDIA_TIMEOUT_MS=90000
VIDEO_MAX_SECONDS=20
AUDIO_MAX_SECONDS=300
LOG_LEVEL=info
# Exact numeric Telegram sender IDs. No wildcard. Commands available in DMs only.
SANDBOX_ALLOWED_USERS=
SANDBOX_IMAGE=kamakura-sandbox:local
SANDBOX_INSTANCE=default
SANDBOX_DISK=35G
SANDBOX_CPUS=2
SANDBOX_MEMORY=3g
# Chromium + XFCE need headroom for threads and Docker exec.
SANDBOX_PIDS=256
SANDBOX_NETWORK=false
# Optional userspace daemon. Requires network=true; auth is per-user.
SANDBOX_TAILSCALE=false
# JSON map of exact Telegram IDs to auth keys; core-only file, never commit it.
# Compose mounts ./config read-only at /app/config.
SANDBOX_TAILSCALE_AUTH_KEYS_FILE=
SANDBOX_IDLE_SECONDS=1800
SANDBOX_COMMAND_TIMEOUT_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=16000
SANDBOX_MAX_CONTAINERS=4
# Host bind root. Compose resolves relative paths against the project directory.
SANDBOX_ROOT=./sandboxes
# Explicitly accepts a SOFT pre-command disk check, not a hard disk quota.
SANDBOX_ALLOW_SOFT_QUOTA=false
# Linux socket group, from stat -c '%g' /var/run/docker.sock. Usually 0 on Desktop.
DOCKER_GID=0
