OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Responses reasoning effort: none, low, medium, high, xhigh, max
OPENAI_REASONING_EFFORT=medium
CHAT_MAX_STEPS=12
CHAT_CONTEXT_TOKENS=256000
WORKER_CONTEXT_TOKENS=256000
# Background tasks use the same OPENAI_MODEL, with their own reasoning budget.
OPENAI_WORKER_EFFORT=high
WORKER_TIMEOUT_MS=600000
WORKER_MAX_OUTPUT_TOKENS=4096
WORKER_MAX_STEPS=24
WORKER_MAX_CONCURRENT=2
TELEGRAM_BOT_TOKEN=
# Exact chat IDs, comma separated. Empty denies all. * allows all (not recommended).
TELEGRAM_ALLOWED_CHATS=
# ambient lets the model choose explicit delivery or silence. mentions accepts mentions/replies only.
TELEGRAM_GROUP_MODE=ambient
ENABLE_REACTIONS=true
DATA_DIR=./data
# Sole runtime storage. Compose mongo has no auth or public ports, core-only internal network.
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=kamakura
# Stable 8.0 default requires supported kernel. Linux 6.19..7.0.13 needs a kernel upgrade.
# An explicit mongo:7.0 image can support older test hosts; never downgrade an existing 8.0 database.
MONGODB_IMAGE=mongodb/mongodb-community-server:8.0-ubi8
PERSONA_PATH=./persona.md
HISTORY_LIMIT=40
# Same-owner chronological neighbors on each side of search hits, merged by stored record identity.
HISTORY_CONTEXT_MESSAGES=3
# Exact authenticated owners permitted to teach lessons. Empty disables writes, * never works.
LEARNING_OWNER_IDS=
ENABLE_LEARNING=true
LEARNING_MAX_BYTES=16384
LEARNING_MAX_LESSONS=32
LEARNING_REVISIONS=10
LEARNING_DEBOUNCE_MS=15000
LEARNING_INTERVAL_MS=60000
LEARNING_TIMEOUT_MS=30000
DEBOUNCE_MS=4000
MESSAGE_DELAY_MS=800
MAX_REPLY_MESSAGES=3
MAX_REPLY_CHARS=1200
MAX_INPUT_CHARS=8000
MAX_OUTPUT_TOKENS=2048
MAX_CONCURRENT_REQUESTS=2
REQUEST_TIMEOUT_MS=120000
ENABLE_WEB_SEARCH=true
# Optional TTS has its own credentials. Blank settings omit voice replies.
SPEECH_TTS_BASE_URL=
SPEECH_TTS_API_KEY=
SPEECH_TTS_MODEL=
SPEECH_TTS_VOICE=
# Voice notes and extracted video audio use /v1/audio/transcriptions (mono WAV).
# noVNC gateway. Public HTTPS origin supplied by your own reverse proxy; blank disables it.
NOVNC_PUBLIC_URL=
NOVNC_BIND_ADDRESS=127.0.0.1
NOVNC_PORT=47831
# Container listener. Use 127.0.0.1 for direct Node with nginx on the same host.
NOVNC_HOST=0.0.0.0
# Exact immediate proxy peer IPs as seen by the gateway, not client IPs/CIDRs.
# Host nginx via Compose may appear as the Compose bridge gateway, e.g. 172.18.0.1.
NOVNC_TRUSTED_PROXIES=
# DESKTOP_PUBLIC_BASE_URL, DESKTOP_PORT, DESKTOP_HOST and DESKTOP_BIND_ADDRESS
# remain fallback aliases. NOVNC_* takes precedence when set.
# One-time path bootstrap and independent cookie session lifetime, 1 hour default, 24 hours max.
DESKTOP_TOKEN_TTL_MS=3600000

OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Independent speech host/key. Custom host requires its own key; no chat-key forwarding.
OPENAI_TRANSCRIBE_BASE_URL=
OPENAI_TRANSCRIBE_API_KEY=
MAX_MEDIA_BYTES=20971520
MEDIA_TIMEOUT_MS=90000
VIDEO_MAX_SECONDS=20
AUDIO_MAX_SECONDS=300
LOG_LEVEL=info
# Exact numeric Telegram sender IDs. No wildcard. Commands available in DMs only.
SANDBOX_ALLOWED_USERS=
SANDBOX_IMAGE=kamakura-sandbox:local
# Writable ephemeral root + passwordless sudo requires actual daemon userns-remap.
SANDBOX_USERNS_ROOT=false
# Socket of operator-managed remapped daemon, never exposed to user containers.
SANDBOX_DOCKER_SOCKET=/var/run/docker.sock
CORE_DOCKER_SOCKET_PATH=/var/run/docker.sock
SANDBOX_INSTANCE=default
SANDBOX_DISK=35G
SANDBOX_CPUS=2
SANDBOX_MEMORY=3g
# Chromium + XFCE need headroom for threads and Docker exec.
SANDBOX_PIDS=256
SANDBOX_NETWORK=false
SANDBOX_IDLE_SECONDS=1800
SANDBOX_COMMAND_TIMEOUT_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=16000
SANDBOX_MAX_CONTAINERS=4
# Host bind root. Compose resolves relative paths against the project directory.
SANDBOX_ROOT=./sandboxes
# Explicitly accepts a SOFT pre-command disk check, not a hard disk quota.
SANDBOX_ALLOW_SOFT_QUOTA=false
# Linux socket group, from stat -c '%g' /var/run/docker.sock. Usually 0 on Desktop.
DOCKER_GID=0

# Bounded fsynced history recovery journal, not an alternate database.
STORAGE_BUFFER_MAX_BYTES=16777216
# Optional semantic fallback after zero keyword hits. All three required.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_MS=5000
EMBEDDING_MIN_SCORE=0.3
