# Essential configuration. Optional settings live in .env.advanced.
STORAGE=mongo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_OWNER_IDS={}
WHATSAPP_ENABLED=false
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_OWNER_NUMBERS={}
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
DEFAULT_TIMEZONE=UTC
SANDBOX_ALLOWED_USERS=
PERSONA_FILE=./persona.md
CONFIG_DIR=./config
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=kamakura
MONGODB_IMAGE=mongodb/mongodb-community-server:8.0-ubi8
NOVNC_BIND_ADDRESS=127.0.0.1
NOVNC_PORT=47831
DESKTOP_PORT=47831
DESKTOP_BIND_ADDRESS=127.0.0.1
SANDBOX_IMAGE=kamakura-sandbox:local
SANDBOX_EGRESS_IMAGE=kamakura-egress:local
SANDBOX_DENIED_IPS=
SANDBOX_ROOTFS_SIZE=
SANDBOX_DOCKER_SOCKET=/var/run/docker.sock
SANDBOX_INSTANCE=default
SANDBOX_DISK=35G
SANDBOX_CPUS=2
SANDBOX_MEMORY=3g
SANDBOX_PIDS=256
SANDBOX_IDLE_SECONDS=1800
SANDBOX_COMMAND_TIMEOUT_SECONDS=30
SANDBOX_MAX_OUTPUT_BYTES=16000
SANDBOX_ROOT=./sandboxes
SANDBOX_ALLOW_SOFT_QUOTA=false
DOCKER_GID=0
SANDBOX_NETWORK_NAME=
LOCAL_DEVICES_PORT=47943
LOCAL_DEVICES_BIND_ADDRESS=127.0.0.1
DISCORD_VOICE_BUILD=false
DISCORD_VOICE_ENABLED=false
