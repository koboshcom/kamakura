<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.kamakura.bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>dist/imessage-host.js</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/YOU/kamakura</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/kamakura/data/kamakura.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/kamakura/data/kamakura.log</string>
</dict>
</plist>
